{
  "name": "DrayMusicDesktop",
  "version": "2.0.0",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.draydenytprojects.draymusicdesktop",
    "productName": "DrayMusic Desktop",
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
