{
  "name": "DrayMusicDesktop",
  "version": "2.5.0",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.draydenytprojects.draymusicdesktop",
    "productName": "DrayMusic Desktop",
    "protocols": [
      {
        "name": "DrayMusic Link",
        "schemes": [
          "draymusic"
        ]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "bindings": "^1.5.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "node-addon-api": "^1.7.2"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "overrides": {
    "discord-rpc": {
      "register-scheme": "0.0.2"
    }
  }
}
